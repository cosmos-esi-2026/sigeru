        <mxCell id="pkgE" value="&lt;b style='font-size:13px;'&gt;E. Consultas y reportes (2 CU)&lt;/b&gt;&lt;br&gt;&lt;span style='font-style:italic;font-size:9px;color:#666666;'&gt;Actor: Administrador municipal&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#333333;'&gt;CU-029 Consultar inventario de recursos&lt;br&gt;CU-030 Generar reporte de incidencias por zona&lt;/span&gt;" style="shape=folder;fontStyle=1;spacingTop=6;tabWidth=90;tabHeight=16;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;spacingRight=6;fillColor=#f7f8fd;strokeColor=#8f9dc9;fontColor=#33406b;" vertex="1" parent="1">

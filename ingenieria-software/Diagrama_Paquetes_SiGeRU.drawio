        <mxCell id="pkgD" value="<b style='font-size:13px;'>D. Operación e incidencias (6 CU)</b><br><span style='font-style:italic;font-size:9px;color:#666666;'>Actores: Vecino, Administrador municipal, Cuadrilla de recolección</span><br><span style='font-size:9px;color:#333333;'>CU-023 Registrar incidencia<br>CU-024 Adjuntar evidencia fotográfica «extend»<br>CU-025 Asignar incidencia a cuadrilla<br>CU-026 Actualizar estado de incidencia<br>CU-027 Registrar estado de contenedor «include»<br>CU-028 Consultar incidencias</span>" style="shape=folder;fontStyle=1;spacingTop=6;tabWidth=90;tabHeight=16;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;spacingRight=6;fillColor=#f7f8fd;strokeColor=#8f9dc9;fontColor=#33406b;" vertex="1" parent="1">

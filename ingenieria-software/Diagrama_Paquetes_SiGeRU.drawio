        <mxCell id="pkgB" value="<b style='font-size:13px;'>B. Gestión de usuarios (7 CU)</b><br><span style='font-style:italic;font-size:9px;color:#666666;'>Actor: Administrador municipal</span><br><span style='font-size:9px;color:#333333;'>CU-005 Aprobar o rechazar solicitud de registro<br>CU-006 Registrar usuario<br>CU-007 Modificar usuario<br>CU-008 Deshabilitar usuario<br>CU-009 Consultar usuarios<br>CU-010 Filtrar listado de usuarios «extend»<br>CU-011 Asignar rol a usuario</span>" style="shape=folder;fontStyle=1;spacingTop=6;tabWidth=90;tabHeight=16;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;spacingRight=6;fillColor=#f7f8fd;strokeColor=#8f9dc9;fontColor=#33406b;" vertex="1" parent="1">

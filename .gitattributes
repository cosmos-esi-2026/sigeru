# Archivos binarios: Git no debe tocarles los saltos de linea.
# Sin esto, al clonar el repositorio en Windows (core.autocrlf=true) los PDF y
# los .dia se corrompen porque Git les inserta retornos de carro.

*.pdf   binary
*.dia   binary
*.docx  binary
*.xlsx  binary
*.odt   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.svg   binary
*.zip   binary

# Scripts de shell y su configuracion: siempre LF, en cualquier maquina.
# Con core.autocrlf=true (que es lo que tiene este repo en Windows) Git
# convertiria a CRLF al hacer checkout, y un script con CRLF muere en Ubuntu
# con "\r: command not found" en la primera linea.
*.sh        text eol=lf
*.conf      text eol=lf
**/cron/*   text eol=lf

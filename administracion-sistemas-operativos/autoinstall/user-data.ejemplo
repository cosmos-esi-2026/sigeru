#cloud-config
# Plantilla de autoinstall (Ubuntu Server / Subiquity) para sigeru-srv.
#
# Esta es la plantilla que se entrega en el repositorio. El archivo real que
# usa la instalacion (user-data, sin ".ejemplo") tiene el hash de la
# contrasena real del usuario "sigeru" y NO se commitea: vive fuera del
# repositorio, igual que backup.conf con una clave real. Para regenerarlo:
#
#   openssl rand -base64 12                 # genera una contrasena
#   openssl passwd -6 "<esa contrasena>"    # genera el hash SHA-512 para "password:"
#
# Referencia del formato: https://ubuntu.com/server/docs/install/autoinstall-reference
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: latam
  identity:
    hostname: sigeru-srv
    realname: "Equipo COSMOS"
    username: sigeru
    password: "$6$REEMPLAZAR$ponerAcaElHashRealDeOpensslPasswd6NoUnaContrasenaEnTextoPlano"
  ssh:
    install-server: true
    allow-pw: true
  packages: []
  snaps: []
  timezone: America/Montevideo
  storage:
    layout:
      name: direct
  shutdown: reboot

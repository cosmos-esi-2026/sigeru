# ============================================================================
#  SiGeRU 2026 - Tarea programada del respaldo diario
#
#  Este archivo se instala en /etc/cron.d/sigeru-backup (lo hace instalar.sh).
#  cron lo lee solo; no hace falta reiniciar nada. Formato de /etc/cron.d:
#
#      minuto  hora  dia-del-mes  mes  dia-de-la-semana  USUARIO  comando
#
#  A diferencia del crontab de un usuario, aca se indica QUIEN lo corre (root,
#  porque escribe en /backups y /var/log).
#
#  Por que a las 03:00: es la hora de menos uso del sistema (la recoleccion
#  arranca a la manana) y deja margen para que termine antes del primer turno.
#  backup.sh escribe su propio log; lo que llegue a salir por stderr fuera de
#  el (un error del propio bash, por ejemplo) se agrega al mismo archivo.
# ============================================================================
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
MAILTO=""

0 3 * * * root /opt/sigeru/respaldo/backup.sh >/dev/null 2>>/var/log/sigeru-backup.log

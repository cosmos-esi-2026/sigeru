Options -Indexes

# Paginas de error propias (extras, parte 22): no muestran la version del servidor ni rutas internas. Solo se usan cuando el
# error lo genera Apache; las APIs contestan sus errores en JSON y esos no se tocan.
ErrorDocument 403 /sigeru/landing/errores/403.html
ErrorDocument 404 /sigeru/landing/errores/404.html
ErrorDocument 500 /sigeru/landing/errores/500.html

RewriteEngine On
RewriteRule ^(landing|frontend-usuarios|api-usuarios|api-gestion|api-recoleccion)(/|$) - [L]
RewriteRule ^$ - [L]
RewriteRule ^ - [F]

# Cabeceras de seguridad para todo lo que sirve el sistema (OWASP A05). Si el servidor no tiene mod_headers
# simplemente no se agregan; las pruebas (tests/correr-tests.php) avisan si faltan.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "same-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    # Solo se ejecuta codigo propio; el unico servidor externo que se admite es el de los mosaicos del mapa.
    # setifempty: una respuesta que ya trae su propia politica (mas estricta) la conserva.
    Header always setifempty Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tile.openstreetmap.org; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
    Header unset X-Powered-By

    # Las paginas, scripts y estilos se revalidan siempre (el servidor contesta 304 si no cambiaron): sin esto un
    # navegador que ya abrio el sitio puede seguir con una copia vieja y ver la pagina rota.
    <FilesMatch "\.(html|js|css|svg)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
